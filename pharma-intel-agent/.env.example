# ============================================
# pharma-intel-agent 环境变量配置
# 复制本文件为 .env 后填入实际值：
#   cp .env.example .env
# ============================================

# ---- LLM 配置（必填，至少配置一组）----
# 通过 --llm 参数选择提供商，通过 --model 参数覆盖默认模型

# [OpenAI] 默认 LLM 提供商（--llm openai）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# [智谱 ZAI] 使用 --llm zai 时生效
# ZAI_API_KEY=xxxxxxxxxxxxxxxx
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZAI_MODEL=glm-4-flash

# [DeepSeek] 使用 --llm deepseek 时生效
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---- 可选 API Keys ----

# NCBI API Key（加速 PubMed 查询：3 req/s → 10 req/s）
# 申请地址：https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_API_KEY=xxxxxxxxxxxxxxxx
